{
  "name": "karti-app",
  "version": "1.0.0",
  "private": true,
  "description": "KARTI maps and routes",
  "main": "electron-main.cjs",
  "scripts": {
    "build:web": "node scripts/prepare-web.cjs",
    "desktop": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis",
    "android:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.karti.app",
    "productName": "KARTI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "KARTI-Setup-${version}-${arch}.${ext}"
  }
}
