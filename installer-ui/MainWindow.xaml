<Window x:Class="KartiGlassInstaller.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="KARTI Setup" Width="900" Height="590" MinWidth="900" MinHeight="590"
 WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" Foreground="{StaticResource TextMain}"
 FontFamily="Segoe UI Variable, Segoe UI">
 <Window.Resources>
  <Style x:Key="GlassCard" TargetType="Border">
   <Setter Property="CornerRadius" Value="22"/><Setter Property="BorderBrush" Value="#55FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#25FFFFFF" Offset="0"/><GradientStop Color="#20B6E8F7" Offset=".48"/><GradientStop Color="#249B8AFF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
  </Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#18FFFFFF"/><Setter Property="BorderBrush" Value="#30FFFFFF"/><Setter Property="Padding" Value="16,9"/><Setter Property="FontSize" Value="12"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Border x:Name="RootSurface" CornerRadius="28" Background="#78101A2A" BorderBrush="#8CFFFFFF" BorderThickness="1">
   <Border.Effect><DropShadowEffect Color="#5B66FF" BlurRadius="54" ShadowDepth="0" Opacity=".56"/></Border.Effect>
  </Border>
  <!-- Layered specular reflections: these stay visible even when Windows acrylic is unavailable. -->
  <Border x:Name="GlassSheen" Margin="2" CornerRadius="26" IsHitTestVisible="False" BorderThickness="1">
   <Border.BorderBrush>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#E8FFFFFF" Offset="0"/>
     <GradientStop Color="#55D8FFF8" Offset=".22"/>
     <GradientStop Color="#10FFFFFF" Offset=".55"/>
     <GradientStop Color="#669A9DFF" Offset="1"/>
    </LinearGradientBrush>
   </Border.BorderBrush>
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
     <GradientStop Color="#42FFFFFF" Offset="0"/>
     <GradientStop Color="#14C4FFF5" Offset=".12"/>
     <GradientStop Color="#04FFFFFF" Offset=".42"/>
     <GradientStop Color="#08A2A9FF" Offset=".78"/>
     <GradientStop Color="#28FFFFFF" Offset="1"/>
    </LinearGradientBrush>
   </Border.Background>
  </Border>
  <Border x:Name="TopGlassReflection" Margin="3,3,3,0" Height="150" VerticalAlignment="Top" CornerRadius="25,25,110,110" IsHitTestVisible="False" Opacity=".9">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
     <GradientStop Color="#2DFFFFFF" Offset="0"/>
     <GradientStop Color="#14BDFBF0" Offset=".25"/>
     <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
   </Border.Background>
  </Border>
  <Rectangle x:Name="GlassLightStreak" Width="190" Height="690" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="125,0,0,0" IsHitTestVisible="False" Opacity=".34" RadiusX="95" RadiusY="95">
   <Rectangle.Fill>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
     <GradientStop Color="#00FFFFFF" Offset="0"/>
     <GradientStop Color="#24FFFFFF" Offset=".42"/>
     <GradientStop Color="#48D7FFF7" Offset=".5"/>
     <GradientStop Color="#16FFFFFF" Offset=".62"/>
     <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
   </Rectangle.Fill>
   <Rectangle.RenderTransform><RotateTransform Angle="-17" CenterX="95" CenterY="345"/></Rectangle.RenderTransform>
   <Rectangle.Effect><BlurEffect Radius="12"/></Rectangle.Effect>
  </Rectangle>
  <Ellipse x:Name="GlowLeft" Width="420" Height="300" Fill="#353DF4D8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-145,0,0"><Ellipse.Effect><BlurEffect Radius="75"/></Ellipse.Effect></Ellipse>
  <Ellipse x:Name="GlowRight" Width="380" Height="320" Fill="#354F49FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-140"><Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect></Ellipse>
  <Grid Margin="30,22,30,24">
   <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
   <Grid Grid.Row="0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="38" Height="38" CornerRadius="13" Background="#3BFFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1"><TextBlock Text="K" FontSize="25" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="KARTI" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="LIQUID GLASS SETUP" FontSize="9" Foreground="#AFC9D9" Margin="1,1,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ThemeButton" Content="☼  Светлая тема" Style="{StaticResource TabButton}" Click="ThemeToggle_Click" Margin="0,0,12,0"/>
     <Button Content="—" Width="38" Height="34" Padding="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" Click="Minimize_Click" Margin="0,0,7,0"/>
     <Button Content="✕" Width="38" Height="34" Padding="0" Background="#20FFFFFF" BorderBrush="#38FFFFFF" Click="Close_Click"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="16" Padding="7" Margin="0,14,0,18">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Button x:Name="InstallTab" Content="Установка" Style="{StaticResource TabButton}" Click="TabInstall_Click" Margin="3,0"/>
     <Button x:Name="PlaceTab" Content="Место установки" Style="{StaticResource TabButton}" Click="TabPlace_Click" Margin="3,0"/>
     <Button x:Name="AboutTab" Content="О KARTI" Style="{StaticResource TabButton}" Click="TabAbout_Click" Margin="3,0"/>
    </StackPanel>
   </Border>
   <Grid Grid.Row="2" Margin="0,0,0,12">
    <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" Margin="62,0">
     <Border Style="{StaticResource GlassCard}" Padding="12,7" HorizontalAlignment="Left" Margin="0,0,0,17" CornerRadius="12"><TextBlock Text="✦  KARTI ДЛЯ WINDOWS  •  V1.0.2" FontSize="10" Foreground="#D7FFF8"/></Border>
     <TextBlock Text="Твоя карта начинается здесь." FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Установи KARTI и открой для себя новый способ исследовать мир." FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,22" LineHeight="22"/>
     <Border Style="{StaticResource GlassCard}" Padding="17">
      <StackPanel><TextBlock Text="МЕСТО УСТАНОВКИ" FontSize="10" Foreground="#B9D2E2"/>
       <Grid Margin="0,10,0,0"><TextBox x:Name="FolderBox" TextChanged="FolderBox_TextChanged" Background="#1BFFFFFF" Foreground="#F5FBFF" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="11,10" FontSize="12" CaretBrush="White" SelectionBrush="#8075E7FF"/><Button Content="Обзор…" Width="88" Padding="7,8" HorizontalAlignment="Right" Click="Browse_Click" Margin="0,0,4,0" FontSize="12"/></Grid>
      </StackPanel>
     </Border>
     <TextBlock Text="Можно изменить путь или имя конечной папки, например D:\Программы\KARTI." FontSize="11" Foreground="#A7C0D1" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel x:Name="PlacePanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="62,0">
     <TextBlock Text="Где будет жить KARTI?" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Укажи полный путь — последняя часть пути станет названием папки приложения." FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,22" LineHeight="22"/>
     <Border Style="{StaticResource GlassCard}" Padding="18">
      <StackPanel><TextBlock Text="НАЗВАНИЕ И МЕСТО" FontSize="10" Foreground="#B9D2E2"/>
       <TextBox x:Name="PlacePathBox" TextChanged="PlacePathBox_TextChanged" Background="#1BFFFFFF" Foreground="#F5FBFF" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="12" FontSize="13" Margin="0,10,0,10"/>
       <TextBlock Text="Пример: C:\Users\ТЫ\Apps\KARTI-Home" Foreground="#A7C0D1" FontSize="11"/>
       <Button Content="Выбрать папку…" HorizontalAlignment="Left" Click="Browse_Click" Margin="0,16,0,0"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Изменение здесь синхронизируется с вкладкой «Установка»." FontSize="11" Foreground="#A7C0D1" Margin="0,13,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="AboutPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="62,0">
     <TextBlock Text="KARTI, в своём стиле." FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Установщик с многослойными стеклянными поверхностями, бирюзовыми бликами и мягким фиолетовым свечением." FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,22" LineHeight="22"/>
     <Border Style="{StaticResource GlassCard}" Padding="18"><StackPanel><TextBlock Text="LIQUID GLASS" FontSize="11" FontWeight="Bold"/><TextBlock Text="Настрой внешний вид переключателем вверху. Установка запускает настоящий пакет KARTI, встроенный в установщик." FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="21"/></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="62,0">
     <TextBlock Text="Создаём твоё пространство" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="StatusText" Text="Подготовка файлов…" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,14,0,25"/>
     <Border Style="{StaticResource GlassCard}" Padding="20"><StackPanel><ProgressBar Height="5" IsIndeterminate="True" Background="#1FFFFFFF" Foreground="#6EF7DB" BorderThickness="0"/><TextBlock Text="Не закрывай окно до завершения." FontSize="11" Foreground="#B8CEDD" Margin="0,16,0,0"/></StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="62,0">
     <Border Width="72" Height="72" CornerRadius="24" Background="#333BE8C6" BorderBrush="#887DFFE5" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,22"><TextBlock Text="✓" FontSize="39" Foreground="#B8FFED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="KARTI готова." FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Установка завершена. Можно отправляться." FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="62,0">
     <TextBlock Text="Не получилось установить" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFD0DC" FontSize="13" Margin="0,14,0,0" LineHeight="21"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="3">
    <TextBlock x:Name="FooterText" Text="KARTI • LIQUID GLASS EXPERIENCE" FontSize="9" Foreground="#7F9EB4" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelButton" Content="Отмена" Background="#1FFFFFFF" BorderBrush="#35FFFFFF" Margin="0,0,10,0" Click="Close_Click"/>
     <Button x:Name="InstallButton" Content="Установить KARTI  ↗" MinWidth="174" Click="Install_Click"/>
     <Button x:Name="LaunchButton" Content="Запустить KARTI  ↗" MinWidth="174" Visibility="Collapsed" Click="Launch_Click"/>
     <Button x:Name="RetryButton" Content="Повторить" MinWidth="130" Visibility="Collapsed" Click="Retry_Click"/>
    </StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>